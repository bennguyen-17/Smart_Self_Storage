# Base URL Backend Spring Boot (qua Vite proxy hoặc trực tiếp)
VITE_API_BASE_URL=/api

# Bật/tắt chế độ Mock Data
# true = Dùng dữ liệu mẫu chạy độc lập (khi Backend chưa xong)
# false = Gọi API thật theo Swagger backend
VITE_USE_MOCK=false

# Hiện công cụ demo khi bảo vệ đồ án (VD: nút "Chạy quét No-Show ngay bây giờ")
# Chỉ bật ở máy dev/demo, KHÔNG bật khi deploy thật
VITE_ENABLE_DEMO_TOOLS=false

# URL public của website, dùng để sinh link trong email gửi khách
# Để trống = dùng domain đang chạy (window.location.origin)
VITE_PUBLIC_SITE_URL=
